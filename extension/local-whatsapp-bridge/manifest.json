{
  "manifest_version": 3,
  "name": "Local WhatsApp Unread Bridge",
  "version": "1.0.3",
  "key": "",
  "description": "Read only the WhatsApp Web unread badge and expose it locally.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
